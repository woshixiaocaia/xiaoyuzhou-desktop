{
  "name": "xiaoyuzhou-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "node --import ./tests/setup/register.mjs --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:pack": "npm run build && electron-builder --win --dir",
    "electron:dist": "npm run build && electron-builder --win portable",
    "electron:installer": "npm run build && electron-builder --config electron-builder.installer.mjs --win nsis --publish never"
  },
  "dependencies": {
    "@vue/devtools-api": "^8.2.1",
    "pinia": "^4.1.0",
    "qrcode-generator": "^2.0.4",
    "vue": "^3.5.42",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "npm-run-all2": "^9.0.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11",
    "@xmldom/xmldom": "^0.8.15"
  },
  "build": {
    "appId": "com.xiaoyuzhou.desktop",
    "productName": "Xiaoyuzhou",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/app.ico",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/app.ico"
    },
    "portable": {
      "artifactName": "Xiaoyuzhou-${version}-portable.${ext}"
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "description": "一个安静、轻巧的非官方小宇宙桌面播客播放器",
  "author": "woshixiaocaia",
  "license": "MIT"
}
